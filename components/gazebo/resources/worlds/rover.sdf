<?xml version="1.0" ?>
<!--
    This world was copied from the default world supplied by the Gazebo simulator.

    Source: https://github.com/gazebosim/gz-sim/blob/gz-sim9/examples/worlds/default.sdf

    We could not directly use the world provided by Gazebo because the file
    contains a comment with a double hyphen, which is not compatible with the
    XML standard supported by the Python standard library ETree module. Thus we
    have created this copy to solve the issue.
-->
<sdf version="1.6">
  <world name="rover">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>5.0</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-22.9</latitude_deg>
      <longitude_deg>-43.2</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <include>
      <uri>model://ngc_rover</uri>
    </include>
  </world>
</sdf>
